# GameVault configuration.
# Copy to `.env` and fill in what you want. EVERY value is optional --
# the app works with none of them, it just knows less.
#
#   No keys at all  ->  Steam/GOG prices + full Game Pass & EA Play access checks
#   + ITAD key      ->  all-time lows and cross-store prices (the "good deal" answer)
#   + Steam key     ->  "do I already own this on Steam"
#   + itch key      ->  "do I already own this on itch.io"
#   + legendary     ->  "do I already own this on Epic"  (run: .venv\Scripts\legendary auth)

# --- Pricing / deal quality -------------------------------------------------
# Free key: https://isthereanydeal.com/apps/my/
# This is the highest-value key in the file. Without it there are no
# historical lows, so "is it a good deal" degrades to "what % off is it".
ITAD_API_KEY=

# --- Steam ownership --------------------------------------------------------
# Free key: https://steamcommunity.com/dev/apikey
# STEAM_ID is your 64-bit id (steamid.io can convert a vanity URL).
# NOTE: Steam > Profile > Edit Profile > Privacy > "Game details" must be
# PUBLIC, or Steam silently returns an empty library.
STEAM_API_KEY=
STEAM_ID=

# --- itch.io ownership ------------------------------------------------------
# https://itch.io/user/settings/api-keys
ITCH_API_KEY=

# --- Ubisoft Connect ownership (UNOFFICIAL) ---------------------------------
# There is no OAuth path, so this needs your actual account password, and it
# CANNOT work if two-factor authentication is enabled on the account.
# Most Ubisoft games are also on Steam, so Steam ownership usually covers this.
UBISOFT_EMAIL=
UBISOFT_PASSWORD=

# --- Subscriptions you actually have --------------------------------------
# Which Game Pass / EA Play tiers you pay for. This matters for accuracy:
# some titles are on Console Game Pass but NOT PC (Cyberpunk 2077, for one),
# so if this is unset the app assumes you have everything and may tell you a
# game is "included" when your plan cannot launch it.
#
# Plans:  ultimate | pc | console | eaplay | none
# Or list collections directly: pc,console,cloud,eaplay
SUBSCRIPTIONS=

# --- Access control ---------------------------------------------------------
# REQUIRED as soon as this is reachable from anywhere but localhost -- the app
# refuses to start on 0.0.0.0 without it. Not needed for purely local use.
# Generate a strong one with: npm run hash-password
GAMEVAULT_PASSWORD=
# Preferred over the above if you would rather not store the plaintext:
GAMEVAULT_PASSWORD_HASH=

# --- Misc -------------------------------------------------------------------
COUNTRY=US
PORT=8787
# Bind address. 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the
# network, which requires a password above.
HOST=127.0.0.1
